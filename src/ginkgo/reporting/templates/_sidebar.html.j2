<nav class="sidebar">
  <div class="brand">
    {% if logo_src %}<img class="brand-logo" src="{{ logo_src }}" alt="Ginkgo">{% endif %}
    ginkgo<span class="slash">/</span>
  </div>
  <div class="scope">Run report</div>

  <div class="run-id">
    <span class="label">run_id</span>
    {{ report.sidebar_run_id }}
  </div>

  <div class="status-line status-{{ report.sidebar_status_tone }}">
    <span class="glyph"></span>
    {{ report.sidebar_status_label }}
  </div>

  {% for group in report.section_groups %}
  <div class="toc-label">{{ group.label }}</div>
  <ul>
    {% for section in group.sections %}
    <li><a href="#{{ section.anchor }}"><span class="idx">{{ section.number }}</span>{{ section.title }}</a></li>
    {% endfor %}
  </ul>
  {% if not loop.last %}

  {% endif %}
  {% endfor %}

  {% if report.workspace_label %}
  <div class="toc-label">Workspace</div>
  <ul>
    <li><a href="#"><span class="idx">·</span>{{ report.workspace_label }}</a></li>
  </ul>
  {% endif %}
</nav>
