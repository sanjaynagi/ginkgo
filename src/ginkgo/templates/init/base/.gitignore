# pixi.lock is deliberately absent from this file. It is the only record of
# every resolved dependency this project runs. Commit it.

# Pixi's materialised environments, rebuilt from pixi.lock by `pixi install`.
.pixi/

# Ginkgo runtime state: run records, event logs, and the local cache.
.ginkgo/

# Task outputs and logs, reproduced by re-running the workflow.
results/
logs/

# Python bytecode and tool caches.
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# OS noise.
.DS_Store
